@model SiniestroCentralizadoGtoApi.Modelos.Sucursal
@{
    ViewData["Title"] = "Alta";
}

<h1>Alta</h1>


<h2 class="text-center mb-4">🧾 Alta de Nueva Sucursal</h2>

<div class="container mt-4">
    <div class="card shadow rounded p-4">
        <form asp-action="Alta" method="post">
            <div class="form-group mb-3">
                <label asp-for="Nombre" class="form-label">Nombre de la Sucursal</label>
                <input asp-for="Nombre" class="form-control" placeholder="Sucursal" />
                <span asp-validation-for="Nombre" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Direccion" class="form-label">Dirección</label>
                <input asp-for="Direccion" class="form-control" placeholder="Dirección" />
                <span asp-validation-for="Direccion" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Telefono" class="form-label">Teléfono</label>
                <input asp-for="Telefono" class="form-control solo-numeros" placeholder="0000000000" />
                <span asp-validation-for="Telefono" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="CodigoPostal" class="form-label">Código Postal</label>
                <input asp-for="CodigoPostal" class="form-control solo-numeros" placeholder="00000" />
                <span asp-validation-for="CodigoPostal" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Ciudad" class="form-label">Ciudad</label>
                <input asp-for="Ciudad" class="form-control" placeholder="Ciudad" />
                <span asp-validation-for="Ciudad" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Estado" class="form-label">Estado</label>
                <input asp-for="Estado" class="form-control" placeholder="Estado" />
                <span asp-validation-for="Estado" class="text-danger"></span>
            </div>


            <div class="d-flex justify-content-between">
                <a asp-action="Index" class="btn btn-secondary">← Cancelar</a>
                <button type="submit" class="btn btn-primary">✅ Guardar Sucursal</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        $(document).ready(function () {
            $(".solo-numeros").on("input", function () {
                this.value = this.value.replace(/[^0-9]/g, '');
            });
        });
    </script>
}