@model IEnumerable<ReporteVistaModelo>

@{
    ViewData["Title"] = "Listado de Reportes";
}

<h2>@ViewData["Title"]</h2>

@if (Model != null && Model.Any())
{
    <div class="container mt-4  mb-5 border border-dark rounded-4 p-3 shadow">

        <div class="table-responsive shadow rounded-4">
            <table id="reportesTable" class="table table-striped table-hover align-middle text-center mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Número Reporte</th>
                        <th>Sucursal Póliza</th>
                        <th>Número Póliza</th>
                        <th>Contratante</th>
                        <th>Tipo Vehículo</th>
                        <th>Placas</th>
                        <th>Color</th>
                        <th>Fecha Siniestro</th>
                        <th>Dirección Siniestro</th>
                        <th>Taller</th>
                        <th>Responsable Taller</th>
                        <th>Número Siniestro</th>
                        <th>Folio Reporte</th>
                        <th>Tel. Propietario</th>
                        <th>Correo Electrónico</th>
                        <th>Asegurado</th>
                        <th>Propietario Vehículo</th>
                        <th>Deducible</th>
                        <th>% Deducible</th>
                        <th>Descripción</th>
                        <th>Ajustador</th>
                        <th>Observaciones Ajustador</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var reporte in Model)
                    {
                        <tr>
                            <td>@reporte.Id</td>
                            <td>@reporte.Sucursal?.Nombre</td>
                            <td>@reporte.PolizaId</td>
                            <td>@($"{reporte.Contratante?.Nombre} {reporte.Contratante?.ApellidoPaterno} {reporte.Contratante?.ApellidoMaterno}")</td>
                            <td>
                                @{
                                    string tipoVehiculoNombre = reporte.Vehiculo?.IdTipoVehiculo switch
                                    {
                                        1 => "Auto",
                                        2 => "Camioneta",
                                        3 => "Moto",
                                        4 => "SUV",
                                        5 => "Camión",
                                        _ => "Desconocido"
                                    };
                                }
                                @tipoVehiculoNombre
                            </td>
                            <td>@reporte.Vehiculo?.Placas</td>
                            <td>@reporte.Vehiculo?.Color</td>
                            <td>@reporte.FechaSiniestro.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@reporte.LugarSiniestroDireccion</td>
                            <td>@reporte.Taller</td>
                            <td>@reporte.Responsable</td>
                            <td>@reporte.NumSiniestro</td>
                            <td>@reporte.FolioReporte</td>
                            <td>@reporte.TelefonoPropietrio</td>
                            <td>@reporte.Contratante?.CorreoElectronico</td>
                            <td>@reporte.NombreAsegurado</td>
                            <td>@($"{reporte.Contratante?.Nombre} {reporte.Contratante?.ApellidoPaterno} {reporte.Contratante?.ApellidoMaterno}")</td>
                            <td>@(reporte.AplicaDeducible == true ? "Sí" : "No")</td>
                            <td>@reporte.PorcentajeDeducible?.ToString("P")</td>
                            <td>@reporte.DescripcionSiniestro</td>
                            <td>@reporte.Ajustador?.Nombre</td>
                            <td>@reporte.ObservacionesAjustador</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
else
{
    <div class="alert alert-info mt-4">
        No hay reportes disponibles.
    </div>
}

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#reportesTable').DataTable({
                scrollX: true,
                pageLength: 10,
                language: {
                    url: "//cdn.datatables.net/plug-ins/1.13.6/i18n/es-ES.json"
                }
            });
        });
    </script>
}
